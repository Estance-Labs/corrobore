{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "corrobore": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp-server/server.mjs"
      ],
      "env": {
        "CORROBORE_MCP_BASE_URL": "http://127.0.0.1:8080"
      },
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
