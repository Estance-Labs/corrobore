# Corrobore runtime configuration (this repository)
# Copy this file to .env and adjust values for your environment.

# Required by the local server and Docker Compose stack. Replace this example;
# the Compose initializer safely injects the same value into the browser UI.
# Avoid surrounding whitespace because HTTP bearer tokens are sent verbatim.
CORROBORE_HTTP_AUTH_TOKEN=change-me
# Prefer a protected file in production. Set exactly one token source.
# CORROBORE_HTTP_AUTH_TOKEN_FILE=/run/secrets/corrobore-http-token
# CORROBORE_HTTP_AUTH_MODE=required

# Optional secondary bearer token dedicated to admin-only endpoints.
# CORROBORE_HTTP_ADMIN_AUTH_TOKEN=change-me-admin
# CORROBORE_HTTP_ADMIN_AUTH_TOKEN_FILE=/run/secrets/corrobore-http-admin-token

# Optional network settings
# Default binds to loopback only. Compose keeps the published port on loopback
# even though the service binds to 0.0.0.0 inside its private network.
CORROBORE_HTTP_HOST=127.0.0.1
CORROBORE_HTTP_PORT=8080
# Public operational endpoints are safe only on loopback. Remote binds require
# authenticated operations and TLS.
# CORROBORE_OPERATIONAL_ENDPOINT_POLICY=authenticated
# CORROBORE_TLS_ENABLED=true
# CORROBORE_TLS_CERTIFICATE_FILE=/etc/corrobore/tls/server.crt
# CORROBORE_TLS_PRIVATE_KEY_FILE=/etc/corrobore/tls/server.key
# Required host-side source paths for the production Docker Compose service.
CORROBORE_TLS_CERTIFICATE_SOURCE=.corrobore-tls/server.crt
CORROBORE_TLS_PRIVATE_KEY_SOURCE=.corrobore-tls/server.key

# Optional production explorer build directory. The Docker image sets this to
# /app/web; leave it unset for an API-only Rust development workflow.
# CORROBORE_HTTP_WEB_DIR=web/dist

# Persistent canonical graph store. The hot/warm budgets bound the records
# admitted into one request projection; increase them only with measured memory.
# CORROBORE_STORAGE_MODE=persistent
# CORROBORE_STORAGE_DIR=/var/lib/corrobore/graph
# CORROBORE_STORAGE_REQUIRE_FSYNC=true
# CORROBORE_STORAGE_STRICT_RECOVERY=true
CORROBORE_STORAGE_MAX_HOT_NODES=16384
CORROBORE_STORAGE_MAX_HOT_RELATIONSHIPS=32768
CORROBORE_STORAGE_MAX_WARM_ADJACENCY_ENTRIES=65536

# Optional signed enterprise license (recommended).
# The license payload contains client_uuid, client_email, modules, valid_until,
# and optional tags (for example ["NFR"]).
# Provide either inline PEM or a file path, plus a matching public key PEM.
# CORROBORE_HTTP_LICENSE_PEM=
# CORROBORE_HTTP_LICENSE_PEM_FILE=/path/to/license.pem
# CORROBORE_HTTP_LICENSE_PUBLIC_KEY_PEM=
# CORROBORE_HTTP_LICENSE_PUBLIC_KEY_PEM_FILE=/path/to/license-public-key.pem

# Optional enterprise domain-provider deployment. Configure both variables or
# neither. The trusted directory contains only signed release libraries; the
# manifest pins each CTI, FIMI, or Crisis provider by relative path and SHA-256.
# Startup fails before binding the HTTP port if a required provider cannot be
# verified, negotiated through ABI v1, created, or health-checked.
# Example manifest: docs/examples/domain-providers.json
# CORROBORE_DOMAIN_PROVIDER_DIR=/opt/corrobore/providers
# CORROBORE_DOMAIN_PROVIDER_MANIFEST_FILE=/etc/corrobore/domain-providers.json

# Optional timeouts (milliseconds)
CORROBORE_HTTP_REQUEST_TIMEOUT_MS=30000
CORROBORE_HTTP_SHUTDOWN_TIMEOUT_MS=5000

# Optional request body-size limits (bytes)
CORROBORE_HTTP_MAX_BODY_BYTES=2097152
CORROBORE_HTTP_IMPORT_MAX_BODY_BYTES=33554432

# Optional global rate limiting
CORROBORE_HTTP_RATE_LIMIT_PER_SECOND=50
CORROBORE_HTTP_RATE_LIMIT_BURST=200

# --- External connectors and integrations (multi-repo) ---
# This repository ships the core runtime.
# Integration-specific env files should live in their dedicated repositories.
# XTM One assets moved to:
# https://github.com/Noetance-Labs/integration-xtm-one
#
# If you still run the TAXII connector from this workspace, keep these values
# in a connector-local env file and pass it explicitly when launching it.
# Connector docs: docs/user-guide/ingestion.md

# Required: TAXII API root and collection to poll
# CORROBORE_INGEST_TAXII_ROOT_URL=https://taxii.example.org/api/v1
# CORROBORE_INGEST_TAXII_COLLECTION_ID=collection-id

# Optional TAXII authentication: bearer token OR basic credentials, not both
# CORROBORE_INGEST_TAXII_TOKEN=change-me
# CORROBORE_INGEST_TAXII_USERNAME=user
# CORROBORE_INGEST_TAXII_PASSWORD=change-me

# Required: Corrobore HTTP server target for imports
# CORROBORE_INGEST_CORROBORE_BASE_URL=http://127.0.0.1:8080
# CORROBORE_INGEST_CORROBORE_AUTH_TOKEN=change-me

# Optional connector settings
# CORROBORE_INGEST_WORKSPACE_ID=workspace--ingest-taxii
# CORROBORE_INGEST_POLL_INTERVAL_MS=300000
# CORROBORE_INGEST_PAGE_LIMIT=100
# CORROBORE_INGEST_STATE_DIR=.corrobore-runtime/ingest
