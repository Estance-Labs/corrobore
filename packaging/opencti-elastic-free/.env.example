OPENCTI_VERSION=7.260722.0
OPENCTI_BASE_URL=http://localhost:8081
OPENCTI_ADMIN_EMAIL=admin@example.invalid

# Protect the secrets directory with mode 0700 and make its source files
# read-only with mode 0444. Compose bind-mounts each file into containers that
# run under different non-root UIDs; values are never interpolated into the
# Compose model or process arguments.
OPENCTI_ADMIN_PASSWORD_FILE=./secrets/opencti-admin-password
OPENCTI_ADMIN_TOKEN_FILE=./secrets/opencti-admin-token
OPENCTI_HEALTH_KEY_FILE=./secrets/opencti-health-key
OPENCTI_ENCRYPTION_KEY_FILE=./secrets/opencti-encryption-key
CORROBORE_AUTH_TOKEN_FILE=./secrets/corrobore-http-token
RABBITMQ_PASSWORD_FILE=./secrets/rabbitmq-password
MINIO_ROOT_PASSWORD_FILE=./secrets/minio-secret-key
CORROBORE_TLS_CERTIFICATE_FILE=./secrets/tls.crt
CORROBORE_TLS_PRIVATE_KEY_FILE=./secrets/tls.key

# Existing Elasticsearch/OpenSearch migrations additionally set
# OPENCTI_MIGRATION_FROM_REFERENCE=true and use compose.migration.yml.
# CORROBORE_OPENCTI_SHADOW_REFERENCE_ENDPOINT=https://existing-opencti.example/v1/knowledge-data
# CORROBORE_OPENCTI_SHADOW_REFERENCE_VERSION=elasticsearch-8.19.18
# OPENCTI_REFERENCE_AUTH_TOKEN_FILE=./secrets/opencti-reference-token

# Small certified profile defaults. Use profiles/medium.env for the medium gate.
OPENCTI_MEMORY_LIMIT=4g
OPENCTI_CPU_LIMIT=2.0
OPENCTI_NODE_MAX_OLD_SPACE_MB=3072
OPENCTI_CORROBORE_TIMEOUT_MS=60000
CORROBORE_OPENCTI_RATE_LIMIT_PER_SECOND=250
CORROBORE_OPENCTI_RATE_LIMIT_BURST=10000
OPENCTI_WORKER_MEMORY_LIMIT=1g
OPENCTI_WORKER_CPU_LIMIT=1.0
CORROBORE_MEMORY_LIMIT=2g
CORROBORE_CPU_LIMIT=2.0
FILE_WORKER_MEMORY_LIMIT=512m
FILE_WORKER_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512m
RABBITMQ_MEMORY_LIMIT=1g
MINIO_MEMORY_LIMIT=1g
