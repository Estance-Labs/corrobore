      ]
    },
    {
      "id": "ERR-REL-007",
      "title": "Tombstone missing relationship returns RelationshipNotFound",
      "operation": {
        "op": "tombstone_relationship",
        "relationship_id": "relationship--missing-tombstone"
      },
      "expected_error": {
        "variant": "GraphError::RelationshipNotFound",
        "id": "relationship--missing-tombstone"
      },
      "covers": [
        "issue-8",
