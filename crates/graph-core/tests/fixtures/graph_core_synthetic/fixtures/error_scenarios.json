      ]
    },
    {
      "id": "ERR-REL-008",
      "title": "Tombstone already tombstoned relationship returns RecordAlreadyTombstoned",
      "setup": [
        "create actor_apt28",
        "create malware_xagent",
        "create rel_apt28_uses_xagent",
        "tombstone rel_apt28_uses_xagent"
      ],
      "operation": {
        "op": "tombstone_relationship",
        "ref": "rel_apt28_uses_xagent"
      },
      "expected_error": {
